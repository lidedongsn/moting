    },
    "准确率和速度来自在这台 Mac 上对 400 条真实会议语音的实测；没有实测过的模型不显示数字。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accuracy and speed were measured on this Mac with 400 real meeting clips. Models that haven't been measured show no numbers."
          }
        }
      }
    },
    "出错了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        }
      }
    },
