{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moting needs to record system audio to capture what others say in meetings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moting 需要录制系统音频来记录会议中其他人的发言。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When recording starts, Moting reads the current calendar event to name the meeting. Your calendar is read only on this Mac and never uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录音时读取当前时段的日历事件，用它的标题给会议命名。日历内容只在这台 Mac 上读取，不会上传。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When recording starts, Moting reads the current calendar event to name the meeting. Your calendar is read only on this Mac and never uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录音时读取当前时段的日历事件，用它的标题给会议命名。日历内容只在这台 Mac 上读取，不会上传。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moting needs the microphone to record what you say in meetings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Moting 需要麦克风来录制你在会议中的发言。"
          }
        }
      }
    }
  },
  "version": "1.0"
}